<section class="window activity" id="activity" aria-labelledby="activity-title">
  <div class="titlebar">
    <h2 id="activity-title">☷ Activity monitor</h2>
    <button
      class="minimise"
      data-toggle="activity"
      aria-expanded="true"
      aria-controls="activity-body"
      aria-label="Minimise activity monitor"
      hidden
    >
      _
    </button>
  </div>
  <div id="activity-body" class="window-body activity-body">
    <div class="discord inset">
      <div class="avatar" aria-hidden="true">
        ☾
      </div>
      <div class="discord-details">
        <a
          class="discord-name"
          href="https://discord.com/users/749389300768047226"
        >
          lisa_s000 ↗
        </a>
        <p class="presence" data-state="unknown">
          <span class="status-dot" aria-hidden="true"></span>
          <span data-presence>Status unavailable</span>
        </p>
      </div>
      <div class="discord-activity">
        <strong id="activity-name">Activity unavailable</strong>
        <p id="activity-detail">The presence feed has not connected.</p>
        <p id="custom-status" hidden></p>
      </div>
    </div>
    <div class="spotify inset">
      <div class="player-heading">
        <h3>♫ Spotify</h3>
        <span id="music-state">UNAVAILABLE</span>
      </div>
      <div class="track-row">
        <div class="album">
          <span id="album-placeholder" aria-hidden="true">
            ♫
          </span>
          <img id="album-art" alt="" width="56" height="56" hidden />
        </div>
        <div class="track">
          <strong id="track-name">Listening status unavailable</strong>
          <span id="track-artist">Waiting for the presence feed.</span>
          <span id="track-album"></span>
        </div>
      </div>
      <div class="timeline" id="timeline" hidden>
        <span id="elapsed">00:00</span>
        <progress
          id="track-progress"
          aria-label="Track progress"
          max="100"
          value="0"
        ></progress>
        <span id="duration">00:00</span>
      </div>
      <a id="track-link" href="https://open.spotify.com/" hidden>
        Open track on Spotify ↗
      </a>
    </div>
    <div class="feed-footer">
      <span id="feed-state" role="status">
        Live status needs JavaScript.
      </span>
      <button class="raised" id="retry" hidden>
        Retry
      </button>
    </div>
    <noscript>
      <p class="no-script">
        Enable JavaScript for Discord and Spotify status. Everything else is
        available below.
      </p>
    </noscript>
  </div>
</section>
