---
import AgeTracker from "./AgeTracker.astro";
---

<section class="window intro" id="intro" aria-labelledby="intro-title">
  <div class="titlebar">
    <h2 id="intro-title">▤ hello.txt — Notepad</h2>
    <button
      class="minimise"
      data-toggle="intro"
      aria-expanded="true"
      aria-controls="intro-body"
      aria-label="Minimise introduction"
      hidden
    >
      _
    </button>
  </div>
  <div id="intro-body" class="window-body">
    <nav class="menu" aria-label="Introduction links">
      <a href="https://github.com/LisaScheers">My code ↗</a>
      <a href="https://discord.com/users/749389300768047226">Say hello ↗</a>
    </nav>
    <div class="paper inset">
      <h1>hi, i’m Lisa :3</h1>
      <p class="presence" data-state="unknown">
        <span class="status-dot" aria-hidden="true"></span>
        <span data-presence>Status unavailable</span>
      </p>
      <AgeTracker />
      <p>I make things for the web and tinker with the systems behind them.</p>
      <p>This is my little corner of the internet. Make yourself at home.</p>
      <p>
        I like systems I can understand and change. Most of mine live in{" "}
        <a href="https://github.com/LisaScheers/Forge">Forge</a>, described in
        Nix.
      </p>
      <p class="notepad-note">// a few things I’m working on ↓</p>
    </div>
    <div class="statusbar">
      <span>hello.txt</span>
      <span>plain old text</span>
    </div>
  </div>
</section>
